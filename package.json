{
  "name": "stars-upon-you",
  "private": true,
  "version": "0.1.0",
  "description": "STARS UPON YOU. \u2014 an interactive explorer for NASA SPHEREx infrared observations.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsx tests/run.ts && tsx tests/aws.ts && tsx tests/sky.ts",
    "test:live": "tsx tests/live.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
